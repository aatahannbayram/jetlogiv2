{
  "name": "dijigoo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "openapi": "pnpm --filter @dijigoo/contracts run openapi",
    "db:generate": "pnpm --filter @dijigoo/db run generate",
    "db:migrate": "pnpm --filter @dijigoo/db run migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "turbo": "^2.0.9",
    "typescript": "^5.5.4"
  }
}
