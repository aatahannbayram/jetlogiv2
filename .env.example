# Kopyalayin: cp .env.example .env
# Gercek sirlar asla depoya girmez.

NODE_ENV=development

# --- Veritabani ---------------------------------------------------------
DATABASE_URL=postgres://dijigoo:dijigoo@localhost:5434/dijigoo

# --- Redis (BullMQ kuyruklari, idempotency, hiz siniri) -----------------
REDIS_URL=redis://localhost:6380

# --- Nesne depolama (yerelde MinIO, uretimde R2) ------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dijigoo-media
S3_SHIFT_PHOTO_BUCKET=dijigoo-shift-photos
S3_ACCESS_KEY_ID=dijigoo
S3_SECRET_ACCESS_KEY=dijigoo123
S3_FORCE_PATH_STYLE=true

# --- Token imzalama -----------------------------------------------------
# Uretimde: openssl rand -base64 48
# Buradaki degerler sadece `cp .env.example .env` sonrasi API'nin acilmasi icin
# yeterli uzunlukta; hicbir ortamda oldugu gibi kullanilmamali.
JWT_ACCESS_SECRET=yerel-gelistirme-anahtari-uretimde-mutlaka-degistir
JWT_REFRESH_SECRET=yerel-yenileme-anahtari-uretimde-mutlaka-degistir
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Alan icerigi sifrelemesi (alici telefonu vb.) ----------------------
# AES-256-GCM anahtari, base64, 32 bayt.
FIELD_ENCRYPTION_KEY=eWVyZWwtZ2VsaXN0aXJtZS1hbmFodGFyaS0zMmJ5dGUh

# --- Servisler ----------------------------------------------------------
API_PORT=3001
API_BASE_URL=http://localhost:3001
PANEL_PORT=3000

# --- SMS / OTP (docs/02-saglayici-degerlendirme.md) ---------------------
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=DIJIGOO

# --- Maskeli arama / IVR ------------------------------------------------
MASKED_CALL_PROVIDER=mock
MASKED_CALL_API_KEY=
MASKED_CALL_POOL_PREFIX=

# --- Geocoding / rota ---------------------------------------------------
# Faz 1: trafiksiz. Ucretli trafik icin GOOGLE veya MAPBOX (Faz 1.5).
# osrm = kendi barindirdigimiz motor, bkz. infra/osrm/. mock = disi
# bagimlilik yok, duz hat tahmini (osrm ayakta degilken otomatik dusulen yer).
GEOCODING_PROVIDER=nominatim
ROUTING_PROVIDER=mock
OSRM_URL=http://localhost:5001
PUBLIC_OSRM_URL=https://router.project-osrm.org
ROUTING_API_KEY=

# --- Push ---------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Gozlemlenebilirlik -------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=

# --- Faz 5: gecikme/iptal destek API'si (apps/worker) -------------------
# Operasyon panelinin backend'i bu token ile /v1/tasks/:id/delay-decision
# cagirir. Uretimde: openssl rand -hex 32. Iki tarafta da ayni deger olmali.
DELAY_DECISION_SERVICE_TOKEN=yerel-gelistirme-servis-tokeni-uretimde-degistir
WORKER_POLL_INTERVAL_MS=60000
SLA_RISK_WINDOW_MINUTES=30
