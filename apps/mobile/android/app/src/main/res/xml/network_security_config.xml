<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- dart:io kendi TLS yığınını kullanır; bu pin-set OkHttp / WebView / Cronet içindir. -->
    <domain-config>
        <domain includeSubdomains="true">dijigoo.com</domain>
        <pin-set expiration="2029-02-20">
            <!-- GTS WE1 / WE2 / WR1 / WR2 -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <pin digest="SHA-256">vh78KSg1Ry4NaqGDV10w/cTb9VH3BQUZoCWNa93W/EY=</pin>
            <pin digest="SHA-256">yDu9og255NN5GEf+Bwa9rTrqFQ0EydZ0r1FCh9TdAW4=</pin>
            <pin digest="SHA-256">YPtHaftLw6/0vnc2BnNKGF54xiCA28WFcccjkA4ypCM=</pin>
            <!-- Güncel yaprak, ~14 Eki 2026 -->
            <pin digest="SHA-256">RoH/tTkvQyCBlabxTx57QdBhf05SP5K2Hb5J9zzMX6I=</pin>
        </pin-set>
    </domain-config>
    <!-- JetLogi sunucusu (Caddy, Let's Encrypt): canlı API ve web. En özel
         alan adı eşleşmesi geçerli olduğu için yukarıdaki GTS pin-set'inin
         yerine bu kullanılır. Zincir: YE2 → Root YE → ISRG X2 → ISRG X1. -->
    <domain-config>
        <domain includeSubdomains="false">api-mobile.dijigoo.com</domain>
        <domain includeSubdomains="false">uygulama.dijigoo.com</domain>
        <domain includeSubdomains="false">panel.dijigoo.com</domain>
        <pin-set expiration="2029-02-20">
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
